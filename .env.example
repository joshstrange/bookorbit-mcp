# Choose exactly one BookOrbit authentication mode.
BOOKORBIT_URL=https://bookorbit.example.com

# Native SSO (BookOrbit 3.7): see docs/gateway.md for callback/IdP setup.
# BOOKORBIT_SESSION_FILE=/var/lib/bookorbit-mcp/session.json
# SSO_PROVIDER=authentik
# SSO_REDIRECT_URI=https://bookorbit.example.com/oauth2-callback?bookorbit_mcp=1

# Existing password mode:
BOOKORBIT_USERNAME=your-username
BOOKORBIT_PASSWORD=your-password

# Alternative static token (expires; no refresh):
# BOOKORBIT_TOKEN=

# Optional cache; account/origin and file revisions are isolated automatically.
# CACHE_DIR=

# Default stdio. HTTP must stay on a private gateway-only network.
# MCP_TRANSPORT=http
# MCP_HOST=127.0.0.1
# MCP_PORT=3000
# MCP_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
