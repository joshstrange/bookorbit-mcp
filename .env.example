# BookOrbit MCP configuration. Prefer a scoped, read-only native API key.
BOOKORBIT_URL=https://bookorbit.example.com
# Inject from your secret manager at launch. Do not commit or log the actual value.
BOOKORBIT_API_KEY=your-scoped-api-key

# Compatibility: static Bearer (API key or short-lived JWT), never auto-refreshed.
# Used only when BOOKORBIT_API_KEY is absent.
# BOOKORBIT_TOKEN=

# Explicit legacy password mode, only when both key/token variables are absent.
# BOOKORBIT_AUTH_MODE=password
# BOOKORBIT_USERNAME=
# BOOKORBIT_PASSWORD=

# Content cache is bounded and memory-only. CACHE_DIR is no longer used.
# Old on-disk caches are not read or automatically deleted; remove them manually
# if no other installation needs them. No persistent content retention is enabled.
